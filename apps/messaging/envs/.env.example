## Servis
MODE=

## HTTP (api 8080; messaging ayrı portta)
PORT=
ALLOWED_ORIGINS=
# Ters vekilin (reverse proxy) baktığı PUBLIC alan adı — servisin kendi portu DEĞİL.
# Telegram webhook'u klinik başına buradan türetilip kaydediliyor:
#   ${PUBLIC_BASE_URL}/api/v1/messaging/telegram/bot/${clinicId}
# Yanlış verilirse Telegram güncellemeleri sessizce 404'e gider. HTTPS zorunlu.
PUBLIC_BASE_URL=

## Veri — kendi Mongo veritabanı (replica set zorunlu: transaction gerekir)
MESSAGING_MONGODB_URI=

## Redis — api ile paylaşılır (ActorContext cache + kuyruklar + dedup kilitleri)
REDIS_URL=

## Servisler arası mesajlaşma
NATS_URL=

## Kanal kimlik bilgilerinin şifrelenmesi
TOKEN_CIPHER_KEY=

## WhatsApp
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

## Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

## AI sağlayıcıları (klinik başına seçilir)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
