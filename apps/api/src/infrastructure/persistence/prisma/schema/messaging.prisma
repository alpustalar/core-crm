// Messaging bounded-context — çok kanallı (şimdilik WhatsApp) yazışma.
// Kanal-bağımsız çekirdek (Conversation/Message) + klinik başına kanal config'i.

enum MessageChannel {
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  MEDIA
  INTERACTIVE // buton/liste yanıtı (button_reply / list_reply)
  LOCATION
  CONTACTS
  REACTION // bir mesaja emoji reaksiyon
  UNSUPPORTED // WhatsApp'ın desteklemediği/parse edilemeyen gelen tip
}

enum MessageStatus {
  RECEIVED // gelen mesaj (inbound)
  QUEUED // giden, henüz gönderilmedi
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

/// Kliniğin WhatsApp Business kanal config'i (messaging bounded-context) — Clinic'ten
/// ayrıştırılmış 1:1 satellite. Webhook gelen olayı phoneNumberId ile bu kayda routing eder.
model ClinicWhatsappChannel {
  id String @id @default(uuid())

  phoneNumberId      String    @unique @map("phone_number_id") // Meta WhatsApp phone_number_id
  wabaId             String?   @map("waba_id") // WhatsApp Business Account id
  displayPhoneNumber String?   @map("display_phone_number")
  accessToken        String?   @map("access_token") // şifreli saklanır (CryptoModule)
  verifyToken        String?   @map("verify_token")
  isActive           Boolean   @default(true) @map("is_active")
  registrationPin    String?   @map("registration_pin") // Cloud API register 2FA PIN (şifreli)
  registeredAt       DateTime? @map("registered_at") // numara Cloud API'ye register edildi
  tokenExpiresAt     DateTime? @map("token_expires_at") // accessToken son geçerlilik (reconnect tetikler)
  qualityRating      String?   @map("quality_rating") // GREEN | YELLOW | RED (numara kalitesi)
  messagingTier      String?   @map("messaging_tier") // mesaj limiti tier (ör. TIER_1K)

  clinicId       String @unique @map("clinic_id")
  organizationId String @map("organization_id") // denormalize — Conversation'a taşınır
  clinic         Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_whatsapp_channels")
}

/// Kliniğin AI sohbet asistanı config'i (messaging bounded-context) — Clinic'ten ayrıştırılmış
/// 1:1 satellite. Gelen WhatsApp mesajlarına otomatik yanıt için persona + (şifreli) Anthropic
/// anahtarı + model tutar. Anahtar yoksa platform fallback (ENV.ANTHROPIC_API_KEY) kullanılır.
model ClinicAiAgentConfig {
  id String @id @default(uuid())

  isEnabled            Boolean @default(false) @map("is_enabled")
  model                String  @default("claude-haiku-4-5") // Claude model id (override edilebilir)
  systemPrompt         String? @map("system_prompt") // klinik personası / talimatları
  apiKey               String? @map("api_key") // klinik kendi Anthropic anahtarı (şifreli); null → platform
  maxTokens            Int?    @map("max_tokens") // yanıt üst sınırı (null → varsayılan)
  replyOnlyWithinWindow Boolean @default(true) @map("reply_only_within_window") // 24s pencere dışında sus
  businessHours        Json?   @map("business_hours") // opsiyonel çalışma saati kuralı

  clinicId       String @unique @map("clinic_id")
  organizationId String @map("organization_id") // denormalize
  clinic         Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_ai_agent_configs")
}

/// Bir kontak ile yazışma başlığı (thread). clinicId denormalize scalar (bounded-context;
/// Clinic ilişkisel tablolarına sızılmaz). Kontak hasta/lead ile ilkel id üzerinden eşlenir.
model Conversation {
  id String @id @default(uuid())

  clinicId       String             @map("clinic_id")
  organizationId String             @map("organization_id")
  channel        MessageChannel     @default(WHATSAPP)
  contactPhone   String             @map("contact_phone")
  contactName    String?            @map("contact_name")
  patientId      String?            @map("patient_id")
  leadId         String?            @map("lead_id")
  status         ConversationStatus @default(OPEN)
  assignedUserId String?            @map("assigned_user_id")
  lastMessageAt  DateTime?          @map("last_message_at")
  lastInboundAt  DateTime?          @map("last_inbound_at") // 24s servis penceresi için son gelen mesaj zamanı
  unreadCount    Int                @default(0) @map("unread_count") // ajan görmedi sayacı
  agentReadAt    DateTime?          @map("agent_read_at") // ajanın son okuduğu an
  windowExpiresAt DateTime?         @map("window_expires_at") // aktif WhatsApp konuşma penceresi bitişi
  marketingOptOut Boolean           @default(false) @map("marketing_opt_out") // pazarlama opt-out
  optOutAt       DateTime?          @map("opt_out_at")

  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clinicId, channel, contactPhone])
  @@index([clinicId, status])
  @@map("conversations")
}

/// Yazışma içindeki tek mesaj (gelen/giden).
model Message {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction   MessageDirection
  type        MessageType      @default(TEXT)
  body        String?
  mediaUrl    String?          @map("media_url")
  status      MessageStatus
  externalId  String?          @map("external_id") // WhatsApp mesaj id'si
  errorReason String?          @map("error_reason")
  errorCode   String?          @map("error_code") // WhatsApp hata kodu (ör. 131047)
  sentByUserId String?         @map("sent_by_user_id") // giden mesajı atan personel

  // Zengin gelen tipleri (interactive/location/contacts/reaction) yapısal gövdesi
  payload            Json?   @map("payload")
  replyToExternalId  String? @map("reply_to_external_id") // alıntılanan mesajın wamid'i

  // Giden medya alt-tipi + maliyet/pricing (webhook status'tan)
  mediaType          String?  @map("media_type") // image | document | video | audio | sticker
  pricingCategory    String?  @map("pricing_category") // marketing | utility | authentication | service
  billable           Boolean? @map("billable")

  // TEMPLATE (HSM) gönderimleri — 24s pencere kapalıyken proaktif mesaj
  templateName     String? @map("template_name")
  templateLanguage String? @map("template_language")
  templateParams   Json?   @map("template_params") // sıralı body değişkenleri

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conversationId, createdAt])
  // externalId (WhatsApp wamid) genel benzersizdir; mükerrer webhook teslimine karşı
  // DB-seviyesi idempotency. Outbound mesajlar atanana dek NULL (Postgres'te çoklu NULL serbest).
  @@unique([externalId])
  @@map("messages")
}
