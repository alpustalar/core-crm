model Outbox {
  id          String    @id @default(uuid())
  type        String // Olayın adı (örn: "AppointmentCancelled")
  payload     Json // Olayın içeriği (appointmentId, userId vb.)
  createdAt   DateTime  @default(now())
  processedAt DateTime? // Ne zaman gönderildi? (Null ise henüz gönderilmedi)
}
