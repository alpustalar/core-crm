/// İstihdam tipi (çalışan + sözleşme).
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

/// Çalışan yaşam döngüsü durumu.
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

/// İzin tipi. ANNUAL yıllık hak edişten düşer; diğerleri düşmez.
enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  BEREAVEMENT
  OTHER
}

/// İzin talebi durumu (talep → onay/ret akışı).
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Devam/mesai kaydı durumu (giriş yapıldı / çıkış yapılıp kapatıldı).
enum AttendanceStatus {
  OPEN
  CLOSED
}

/// Personel (İK). organizationId + clinicId birlikte taşınır (franchise/finans konvansiyonu).
/// userId opsiyonel — sisteme giriş yapan kullanıcı/provider'a bounded-context bağı (relation değil).
model Employee {
  id             String @id
  organizationId String @map("organization_id")
  clinicId       String @map("clinic_id")
  userId         String? @map("user_id")

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  email      String?
  phone      String?
  nationalId String? @map("national_id") // TC kimlik no
  title      String? // görev/pozisyon
  department String?

  employmentType EmploymentType @map("employment_type")
  status         EmployeeStatus @default(ACTIVE)

  hireDate        DateTime  @map("hire_date")
  terminationDate DateTime? @map("termination_date")

  annualLeaveEntitlement Int @default(14) @map("annual_leave_entitlement") // yıllık izin gün hakkı

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts         EmployeeContract[]
  leaveRequests     LeaveRequest[]
  attendanceRecords AttendanceRecord[]

  @@index([organizationId])
  @@index([clinicId, status])
  @@map("employees")
}

/// Çalışan sözleşmesi (maaş/istihdam geçmişi). Aynı anda tek aktif sözleşme beklenir.
model EmployeeContract {
  id         String @id
  employeeId String @map("employee_id")

  type        EmploymentType
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date") // süresiz ise null
  grossSalary Decimal   @map("gross_salary") @db.Decimal(12, 2)
  currency    Currency  @default(TRY)
  isActive    Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isActive])
  @@map("employee_contracts")
}

/// İzin talebi. ANNUAL onaylandığında çalışanın yıllık hak edişinden düşülür.
model LeaveRequest {
  id             String @id
  employeeId     String @map("employee_id")
  organizationId String @map("organization_id")
  clinicId       String @map("clinic_id")

  type   LeaveType
  status LeaveStatus @default(PENDING)

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  days      Int // talep edilen gün sayısı
  reason    String?

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?   @map("review_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@index([clinicId, status])
  @@map("leave_requests")
}

/// Çalışan devam/mesai (puantaj) kaydı — giriş/çıkış saatleri + hesaplanan çalışma/fazla mesai süresi.
/// Çalışan+gün başına tek kayıt (manuel giriş; kart okuyucu/PDKS entegrasyonu ileride aynı
/// check-in/check-out komutlarını farklı bir aktörden tetikleyerek eklenebilir).
model AttendanceRecord {
  id             String @id
  employeeId     String @map("employee_id")
  organizationId String @map("organization_id")
  clinicId       String @map("clinic_id")

  workDate   DateTime  @map("work_date") @db.Date
  checkInAt  DateTime  @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")

  workedMinutes   Int? @map("worked_minutes")
  overtimeMinutes Int  @default(0) @map("overtime_minutes")

  status AttendanceStatus @default(OPEN)
  note   String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([clinicId, workDate])
  @@map("attendance_records")
}
