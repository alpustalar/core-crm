// Kliniğin hukuki/mükellefiyet tipi — serbest meslek (muayenehane, e-SMM + stopaj)
// veya kurum (poliklinik/şirket, e-Fatura/e-Arşiv). Posting'te SMM stopaj dalını belirler.
enum ClinicLegalType {
  SERBEST_MESLEK
  KURUM
}

// Kliniğin devlet/regülasyon kimliği (platform/governance bounded-context) —
// Clinic'ten ayrıştırılmış 1:1 satellite. SKRS tesis kodu, USS şifresi ve
// kliniğin kendi vergi numarası (fatura için) burada yaşar.
model ClinicGovernmentSpecs {
  id       String @id
  clinicId String @unique @map("clinic_id")

  // Sağlık Bakanlığı SKRS tesis kodu — e-Nabız için zorunlu
  healthFacilityCode String          @unique @map("health_facility_code")
  ussPassword        String?         @map("uss_password") // İleride gerekecek USS şifresi
  companyTaxNumber   String?         @map("company_tax_number") // Kliniğin VKN'si (fatura)
  legalType          ClinicLegalType @default(KURUM) @map("legal_type") // mükellefiyet tipi

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_government_specs")
}
