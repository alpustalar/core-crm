enum SectorType {
  ALL
  DENTAL
  HAIR_TRANSPLANT
  AESTHETICS
}

model Sector {
  id   String     @id
  slug String     @unique
  name SectorType

  categories            TreatmentCategory[]
  specialties           ProviderSpecialty[]
  providers             Provider[]
  clinics               Clinic[]
  patients              Patient[]
  consentFormTemplates  ConsentFormTemplate[]

  @@map("sectors")
}
