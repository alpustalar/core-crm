// Dış İş Emri (External Work Order): klinik dışındaki üçüncü parti tedarikçilere
// (diş laboratuvarı, saç protezi üreticisi, medikal protez tedarikçisi) verilen
// iş emirlerinin takibi. `supply/work-order` modülü.
//
// Tedarikçi `supply/inventory`'deki Supplier'dır (bounded-context: navigation yok,
// yalnız scalar id). Hasta/tedavi/hekim de scalar id ile taşınır. Klinik içi üretim,
// BOM ve stok tüketimi bu modülün kapsamı DEĞİLDİR. Maliyet alanları raporlama
// içindir; muhasebe fişi üretmez (lab faturası purchase-invoice yolundan işlenir).

enum ExternalWorkOrderStatus {
  DRAFT // hazırlanıyor, tedarikçiye gönderilmedi
  SENT // tedarikçiye gönderildi
  IN_PROGRESS // tedarikçi üretime başladı
  TRY_IN // prova için klinikte
  READY // tedarikçide hazır, teslim bekliyor
  DELIVERED // klinik teslim aldı
  FITTED // hastaya uygulandı (terminal)
  CANCELLED // iptal (terminal)
}

model ExternalWorkOrder {
  id             String @id
  clinicId       String @map("clinic_id")
  organizationId String @map("organization_id") // denormalize — konsolide raporlama
  supplierId     String @map("supplier_id") // inventory Supplier (bounded-context)

  patientId   String? @map("patient_id") // hastaya özel değilse null (stok amaçlı sipariş)
  treatmentId String? @map("treatment_id")
  providerId  String? @map("provider_id") // işi isteyen hekim
  referenceNo String? @map("reference_no") // tedarikçinin kendi fiş/takip no'su

  status ExternalWorkOrderStatus @default(DRAFT)

  sentAt       DateTime? @map("sent_at")
  dueDate      DateTime? @map("due_date") // tedarikçinin verdiği termin
  receivedAt   DateTime? @map("received_at") // klinik teslim aldı
  fittedAt     DateTime? @map("fitted_at") // hastaya uygulandı
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason") @db.Text

  agreedCost Decimal? @map("agreed_cost") @db.Decimal(14, 2) // anlaşılan ücret
  actualCost Decimal? @map("actual_cost") @db.Decimal(14, 2) // teslimde kesinleşen ücret
  currency   Currency @default(TRY)

  // Yeniden yapım: ayrı bir iş emri olarak açılır, orijinaline bağlanır.
  remakeOfId   String? @map("remake_of_id")
  remakeReason String? @map("remake_reason") @db.Text

  // Gecikme bildirimi idempotency izi — aynı iş emri her taramada tekrar bildirmez.
  overdueNotifiedAt DateTime? @map("overdue_notified_at")

  note        String? @db.Text
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items ExternalWorkOrderItem[]

  remakeOf ExternalWorkOrder?  @relation("WorkOrderRemake", fields: [remakeOfId], references: [id], onDelete: SetNull)
  remakes  ExternalWorkOrder[] @relation("WorkOrderRemake")

  @@index([clinicId, status])
  @@index([clinicId, dueDate])
  @@index([supplierId])
  @@index([patientId])
  @@index([organizationId])
  @@map("external_work_orders")
}

model ExternalWorkOrderItem {
  id          String @id
  workOrderId String @map("work_order_id")

  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitCost    Decimal? @map("unit_cost") @db.Decimal(12, 2)

  // Sektöre özgü teknik detay. @shared'deki WorkOrderItemSpecsSchema ile doğrulanır
  // (kind = DENTAL | HAIR | AESTHETIC | GENERIC discriminated union).
  specs Json?

  workOrder ExternalWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("external_work_order_items")
}
