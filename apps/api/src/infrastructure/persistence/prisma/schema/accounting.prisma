// Muhasebe (ledger) katmanı — Hesap Planı (TDHP) + Dönem
// Defter organization (mükellef) seviyesinde tutulur; clinic ileride fiş satırında
// opsiyonel şube boyutu olarak taşınır.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSide {
  DEBIT
  CREDIT
}

model Account {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  code     String // '120', '600.04', '120.01.0001'
  name     String
  parentId String? @map("parent_id")

  type       AccountType
  normalSide AccountSide @map("normal_side")

  isPostable    Boolean @default(true) @map("is_postable") // sadece yaprak hesaba fiş atılır
  requiresParty Boolean @default(false) @map("requires_party") // 120/320 → alt defter (cari) zorunlu

  currency String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Account?     @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]    @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("accounts")
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

model AccountingPeriod {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  year     Int
  status   AccountingPeriodStatus @default(OPEN)
  startsAt DateTime               @map("starts_at")
  endsAt   DateTime               @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  journalEntries JournalEntry[]

  @@unique([organizationId, year])
  @@map("accounting_periods")
}
