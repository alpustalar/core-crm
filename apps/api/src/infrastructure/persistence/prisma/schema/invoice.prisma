enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
  CANCELLED
}

// e-Belge türü (doc 07 §2). Entegratör kapalıyken INTERNAL (iç belge).
enum EDocumentType {
  E_FATURA
  E_ARSIV
  E_SMM
  INTERNAL
}

// e-Belge gönderim yaşam döngüsü (doc 07 §3). Muhasebeden bağımsız outbound durumu.
enum EDocumentStatus {
  DRAFT
  QUEUED
  SENT
  ACCEPTED
  REJECTED
  INTERNAL
  FAILED
}

model Invoice {
  id             String  @id
  organizationId String  @map("organization_id")
  clinicId       String  @map("clinic_id")
  patientId      String  @map("patient_id")
  appointmentId String? @unique @map("appointment_id")
  paymentId     String? @unique @map("payment_id")

  amount   Decimal  @db.Decimal(12, 2) // genel toplam (KDV dahil)
  currency Currency @default(TRY)

  vatRate  Int     @default(10) @map("vat_rate")
  netTotal Decimal @default(0) @map("net_total") @db.Decimal(12, 2) // matrah
  vatTotal Decimal @default(0) @map("vat_total") @db.Decimal(12, 2) // hesaplanan KDV

  status        InvoiceStatus @default(PENDING)
  invoiceNumber String?       @unique @map("invoice_number")
  issuedAt      DateTime?     @map("issued_at")

  // e-Belge (entegratör) outbound durumu — muhasebeyi bloklamaz (doc 07 §5).
  documentType   EDocumentType?  @map("document_type")
  einvoiceUuid   String?         @map("einvoice_uuid") // ETTN/UUID; INTERNAL'de null
  einvoiceStatus EDocumentStatus @default(DRAFT) @map("einvoice_status")

  providerRef String? @map("provider_ref")
  rawResponse Json?   @map("raw_response")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clinicId])
  @@index([patientId])
  @@index([appointmentId])
  @@map("invoices")
}
