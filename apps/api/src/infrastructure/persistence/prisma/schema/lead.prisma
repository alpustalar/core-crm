enum LeadSource {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  TELEGRAM
  META_FORM
  GOOGLE_ADS
  WEBSITE
  MANUAL
}

/// Lead'in kanal içindeki geliş şekli — reklamdan mı (AD), organik mi (ORGANIC),
/// yoksa Lead Ads formundan mı (FORM). `LeadSource` kanalı, `LeadMedium` reklam/organik
/// ayrımını taşır (attribution alanlarıyla birlikte).
enum LeadMedium {
  ORGANIC
  AD
  FORM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id            String  @id
  clinicId      String
  assignedToId  String?
  patientId     String?
  appointmentId String?
  metaLeadId    String? @unique // Meta Lead Ads (form) huni köprüsü — MetaLead kaydına referans
  campaignId    String?
  adId          String?
  adsetId       String?
  ctwaClid      String? // Click-to-WhatsApp click id (ileride Conversions API için)

  whatsAppConversationId String? @unique

  source LeadSource
  status LeadStatus @default(NEW)

  name  String?
  phone String?
  email String?
  notes String? @db.Text

  convertedAt DateTime?

  lostReason String?
  lostAt     DateTime?

  campaignName String?

  // Attribution — lead'in reklam/kaynak kökeni. `medium` reklam/organik/form ayrımı;
  // kampanya/reklam id'leri hem CTWA referral'ından hem Meta Lead Ads formundan doldurulur.
  medium LeadMedium?

  sourceUrl String? // referral kaynak URL'i

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, status])
  @@index([phone])
  @@index([adId])
  @@index([campaignId])
  @@map("leads")
}
