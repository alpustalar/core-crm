{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "baseUrl": "./",
    "paths": {
      "@prisma/client": ["../server-nest/rest/node_modules/@prisma/client"],
      "@shared/*": ["./*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules",
    "dist"]
}